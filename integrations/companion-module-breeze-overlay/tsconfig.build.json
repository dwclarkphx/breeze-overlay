{
  "extends": "@companion-module/tools/tsconfig/node22/recommended-esm.json",
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules/**"],
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "verbatimModuleSyntax": true,
    /*
     * The shared config restricts `lib` to `es2024` with no DOM, which is
     * right for a Node-only module — except `api.ts` uses Node's global
     * `fetch`/`Response`/`RequestInit`/`AbortSignal`, whose ambient types ship
     * in lib.dom.d.ts rather than in `@types/node` itself. Adding `dom` here
     * (not upstream in @companion-module/tools) is type-checking only — it
     * has no runtime effect — and is scoped to this package alone.
     */
    "lib": ["es2024", "dom"]
  }
}
