# Breeze Overlay — environment template.
#
# This file is tracked by git and holds placeholders only. Copy it before you
# put a real key in it:
#
#     cp env.breeze .env          # .env is gitignored, and compose auto-loads it
#     docker compose up -d --build
#
# To keep the name instead, pass it explicitly — but add env.breeze to
# .gitignore first, or your API key ends up on GitHub:
#
#     docker compose --env-file env.breeze up -d --build
#
# `--env-file` is the flag that matters here. The `env_file:` key inside
# docker-compose.yml passes variables into the container but does NOT feed the
# ${BREEZE_PORT} substitution in the ports mapping, so it cannot replace this.

# Listen port. Applied to both the published host port and the server inside
# the container, so the LAN URLs the server logs stay correct.
BREEZE_PORT=7331

# Who this server is, for the outgoing User-Agent on data-source requests.
# api.weather.gov enforces this, and the built-in fallback is shared by every
# Breeze install in the world. Set it.
BREEZE_CONTACT=mystation.com, ops@mystation.com

# Shared secret for mutating /api/* calls, sent as x-breeze-key.
# Empty = no auth, which is only reasonable on an isolated production LAN.
BREEZE_API_KEY=

# UI language for the editor, the portal and the operator panels, as a BCP-47 tag.
#
# An installation setting, not a per-browser one. Nothing is auto-detected and
# there is no per-request override — no Accept-Language, no ?lang= — so everyone
# looking at this server sees the same words for the same buttons. Two crew
# members reading the same control panel in two languages is the failure this
# avoids.
#
# What it does NOT change:
#   /play          the graphic itself, byte-identical on every install
#   /api/*         error messages stay English; each carries a `code` for a
#                  client to translate from
#   clock layers   the language of a clock on air belongs to the graphic, and is
#                  set per layer in the editor (Clock > Language)
#
# Right-to-left languages mirror the chrome. The timeline and the stage do not:
# time runs left to right in every editor, and the stage is a 1:1 preview of
# what goes to air.
#
# Shipped: en
# Testing only: en-XA (bracketed and padded, to find untranslated strings and
#               layouts that break when text grows), ar-XB (English words, RTL
#               direction, to check mirroring while still being able to read it)
#
# An unrecognised tag logs one line and falls back to English rather than
# refusing to start. A tag that is below the 95% translation threshold starts
# with a warning saying how far along it is.
BREEZE_LOCALE=en

BREEZE_LOG_LEVEL=info

# 0 disables all data-source polling.
BREEZE_DATA_POLLING=1

# Hosts the data fetcher may reach despite resolving to a private address.
# A leading dot matches subdomains. Comma-separated.
BREEZE_DATA_ALLOW_HOSTS=

# Data-source credentials as id=value pairs, comma-separated.
# For anything containing a newline, comma or equals sign — a Google
# service-account key, for instance — use BREEZE_DATA_SECRETS_FILE and the
# bind mount in docker-compose.yml instead.
BREEZE_DATA_SECRETS=
