{
  "name": "@breeze/server",
  "version": "0.64.1",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node scripts/build-client.mjs && tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "dev": "node scripts/build-client.mjs && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@breeze/runtime": "workspace:*",
    "@breeze/schema": "workspace:*",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.0.1",
    "basic-ftp": "^6.2.0",
    "fastify": "^5.2.0",
    "marked": "^18.0.9",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ssh2-sftp-client": "^9.0.6",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
